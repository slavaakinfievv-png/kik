# Telegram bot token from @BotFather
BOT_TOKEN=

# STAFF group/channel chat ID
ADMIN_CHAT_ID=

# Telegram user IDs allowed to use admin actions, comma-separated
ADMIN_IDS=

# SQLite database path
DB_PATH=applications.db

# Rotating local log file. Leave empty to disable file logging.
LOG_FILE=bot.log

# Optional HTTPS endpoint that receives JSON error reports.
# Keep the real URL only in the deployment environment, never in Git.
ERROR_WEBHOOK_URL=

# Do not repeat the same admin/webhook error alert more often than this.
ERROR_NOTIFY_COOLDOWN_SECONDS=300
